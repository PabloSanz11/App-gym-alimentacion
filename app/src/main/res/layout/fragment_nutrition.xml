<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero header con objetivo del día -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GymFit Pro"
                android:textColor="#FFFFFF"
                android:alpha="0.7"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true" />

            <!-- Proteína prominente -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proteína del día"
                        android:textColor="#FFFFFF"
                        android:alpha="0.85"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tv_header_protein_current"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_header_protein_goal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" / 170g"
                            android:textColor="#FFFFFF"
                            android:alpha="0.7"
                            android:textSize="16sp"
                            android:layout_marginBottom="4dp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progress_header_protein"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="180dp"
                        android:layout_height="6dp"
                        android:progressTint="@color/colorSecondary"
                        android:progressBackgroundTint="#FFFFFF"
                        android:alpha="0.5"
                        android:progress="0"
                        android:max="170" />
                </LinearLayout>

                <!-- Calorías -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calorías"
                        android:textColor="#FFFFFF"
                        android:alpha="0.7"
                        android:textSize="12sp"
                        android:gravity="end" />

                    <TextView
                        android:id="@+id/tv_header_calories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 2500"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="end" />

                    <TextView
                        android:id="@+id/tv_header_calories_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2500 restantes"
                        android:textColor="#FFFFFF"
                        android:alpha="0.6"
                        android:textSize="11sp"
                        android:gravity="end" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Date Navigation -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_prev_day"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="@string/btn_prev"
                    android:textSize="18sp"
                    app:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/white"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

                <TextView
                    android:id="@+id/tv_current_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1C1C1E" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next_day"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="@string/btn_next"
                    android:textSize="18sp"
                    app:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/white"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Historial rápido: chips últimos 7 días -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true" />

        </HorizontalScrollView>

        <!-- Desayuno Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_desayuno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥛 " android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_desayuno" android:textSize="15sp" android:textStyle="bold" android:textColor="#1C1C1E" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_time_desayuno" android:textSize="12sp" android:textColor="#6C6C70" android:layout_marginTop="2dp" />
                    <TextView android:id="@+id/tv_desayuno_macros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_no_records" android:textSize="13sp" android:textColor="@color/colorPrimary" android:layout_marginTop="4dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_desayuno" android:layout_width="40dp" android:layout_height="40dp" android:text="@string/nutrition_add_food" android:textSize="20sp" android:textColor="@color/white" app:backgroundTint="@color/colorPrimary" style="@style/Widget.Material3.Button.IconButton.Filled" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Almuerzo Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_almuerzo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🍽 " android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_almuerzo" android:textSize="15sp" android:textStyle="bold" android:textColor="#1C1C1E" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_time_almuerzo" android:textSize="12sp" android:textColor="#6C6C70" android:layout_marginTop="2dp" />
                    <TextView android:id="@+id/tv_almuerzo_macros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_no_records" android:textSize="13sp" android:textColor="@color/colorPrimary" android:layout_marginTop="4dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_almuerzo" android:layout_width="40dp" android:layout_height="40dp" android:text="@string/nutrition_add_food" android:textSize="20sp" android:textColor="@color/white" app:backgroundTint="@color/colorPrimary" style="@style/Widget.Material3.Button.IconButton.Filled" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Merienda Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_merienda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥩 " android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_merienda" android:textSize="15sp" android:textStyle="bold" android:textColor="#1C1C1E" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_time_merienda" android:textSize="12sp" android:textColor="#6C6C70" android:layout_marginTop="2dp" />
                    <TextView android:id="@+id/tv_merienda_macros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_no_records" android:textSize="13sp" android:textColor="@color/colorPrimary" android:layout_marginTop="4dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_merienda" android:layout_width="40dp" android:layout_height="40dp" android:text="@string/nutrition_add_food" android:textSize="20sp" android:textColor="@color/white" app:backgroundTint="@color/colorPrimary" style="@style/Widget.Material3.Button.IconButton.Filled" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cena Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_cena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🐟 " android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_cena" android:textSize="15sp" android:textStyle="bold" android:textColor="#1C1C1E" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_time_cena" android:textSize="12sp" android:textColor="#6C6C70" android:layout_marginTop="2dp" />
                    <TextView android:id="@+id/tv_cena_macros" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nutrition_no_records" android:textSize="13sp" android:textColor="@color/colorPrimary" android:layout_marginTop="4dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_cena" android:layout_width="40dp" android:layout_height="40dp" android:text="@string/nutrition_add_food" android:textSize="20sp" android:textColor="@color/white" app:backgroundTint="@color/colorPrimary" style="@style/Widget.Material3.Button.IconButton.Filled" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nutrition_daily_summary" android:textSize="17sp" android:textStyle="bold" android:textColor="#1C1C1E" android:layout_marginBottom="14dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nutrition_calories" android:textSize="13sp" android:textColor="#3C3C43" />
                    <TextView android:id="@+id/tv_total_calories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 2500 kcal" android:textSize="13sp" android:textStyle="bold" android:textColor="#1C1C1E" />
                </LinearLayout>
                <ProgressBar android:id="@+id/progress_calories" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progressTint="@color/colorAccent" android:layout_marginBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nutrition_protein" android:textSize="13sp" android:textColor="#3C3C43" />
                    <TextView android:id="@+id/tv_total_protein" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0g / 170g" android:textSize="13sp" android:textStyle="bold" android:textColor="#1C1C1E" />
                </LinearLayout>
                <ProgressBar android:id="@+id/progress_protein" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progressTint="@color/colorPrimary" android:layout_marginBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nutrition_carbs" android:textSize="13sp" android:textColor="#3C3C43" />
                    <TextView android:id="@+id/tv_total_carbs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0g / 280g" android:textSize="13sp" android:textStyle="bold" android:textColor="#1C1C1E" />
                </LinearLayout>
                <ProgressBar android:id="@+id/progress_carbs" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progressTint="@color/colorTealLight" android:layout_marginBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nutrition_fat" android:textSize="13sp" android:textColor="#3C3C43" />
                    <TextView android:id="@+id/tv_total_fat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0g / 80g" android:textSize="13sp" android:textStyle="bold" android:textColor="#1C1C1E" />
                </LinearLayout>
                <ProgressBar android:id="@+id/progress_fat" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progressTint="@color/colorNavyLight" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Historial 7 días -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Últimos 7 días" android:textSize="17sp" android:textStyle="bold" android:textColor="#1C1C1E" android:layout_marginBottom="12dp" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_weekly_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
