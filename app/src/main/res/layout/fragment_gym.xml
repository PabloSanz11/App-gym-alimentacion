<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <!-- Hero header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GymFit Pro"
                android:textColor="#FFFFFF"
                android:alpha="0.7"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrenamiento"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_suggested_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Siguiente: Día 1"
                android:textColor="#FFFFFF"
                android:alpha="0.75"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progreso"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="#FFFFFF" />

    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ELIGE TU RUTINA DE HOY"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:letterSpacing="0.1"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp" />

    <!-- Peek carousel -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_days"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- Dot indicators -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/layout_day_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

    </LinearLayout>

</LinearLayout>
